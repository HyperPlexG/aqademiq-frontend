<?xml version="1.0" encoding="utf-8"?>
<!-- The rail (v11 LaRail): what the cube loses, the bar gains. Ice on a track
     that is barely there, 6dp with round ends. The colours are resources
     because the shade is light or dark with the phone. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="@color/ambient_rail_track" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="3dp" />
                <solid android:color="@color/ambient_ice" />
            </shape>
        </clip>
    </item>
</layer-list>
