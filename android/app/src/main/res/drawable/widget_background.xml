<?xml version="1.0" encoding="utf-8"?>
<!-- Every widget's card (v11 wg-home): white by day, #1C1C1E by night — the
     widgets follow the theme in v11. The radius follows the launcher's own
     from Android 12 (values-v31/dimens.xml). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_background" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
