<?xml version="1.0" encoding="utf-8"?>
<!-- Intentionally blank.

     Android 12+ always shows a splash window and always puts an icon in it;
     the icon cannot be turned off, only replaced. Replacing it with nothing
     leaves the background colour alone on screen, which is what the app's own
     first frame paints too - so the launcher icon no longer flashes up before
     the intro animation.

     It needs one path, and the path has to be invisible rather than absent: a
     <vector> with no <path> fails to inflate ("no path defined"), the system
     logs "Get attribute fail, return default" and draws the launcher icon
     anyway — the very flash this file exists to remove. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="1dp"
    android:height="1dp"
    android:viewportWidth="1"
    android:viewportHeight="1">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0h1v1h-1z" />
</vector>
