<?xml version="1.0" encoding="utf-8"?>
<!-- This week: a day with no check-in. An empty dashed outline, never a
     puddle — absence is not depletion. 27dp at radius 8, as the app's week
     row draws it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <size android:width="27dp" android:height="27dp" />
    <corners android:radius="8dp" />
    <stroke
        android:width="1.5dp"
        android:color="@color/widget_day_empty"
        android:dashWidth="4dp"
        android:dashGap="3dp" />
</shape>
