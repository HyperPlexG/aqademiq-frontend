<?xml version="1.0" encoding="utf-8"?>
<!-- Four wide and two high: v11 draws This week as wide as the Next and Focus
     pair and as tall as either (wg-home), with the week row under its label.
     Resizable for anyone who wants it bigger.

     previewLayout is the live layout itself: its XML defaults are the design's
     own sample, so the gallery shows the widget as drawn rather than a grey
     placeholder. Refreshed every 30 minutes as well as whenever the app
     publishes, which is what moves "today" across midnight. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:minResizeHeight="90dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_week"
    android:previewLayout="@layout/widget_week"
    android:description="@string/widget_week_description"
    android:widgetCategory="home_screen" />
