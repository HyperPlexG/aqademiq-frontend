<?xml version="1.0" encoding="utf-8"?>
<!-- previewLayout is the live layout itself: its XML defaults are the spec's
     own sample, so the gallery shows the widget as drawn in §5 rather than a
     grey placeholder. Refreshed every 30 minutes as well as whenever the app
     publishes, which is what moves "today" across midnight. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:resizeMode="none"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_focus"
    android:previewLayout="@layout/widget_focus"
    android:description="@string/widget_focus_description"
    android:widgetCategory="home_screen" />
