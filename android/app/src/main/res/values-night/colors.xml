<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The accent the session card and App freeze's notices are tinted
         with; the same by night (the system adjusts it for contrast). -->
    <color name="notification_color">#FF6B5CF0</color>
    <!-- AppColors.surface, dark. -->
    <color name="splash_background">#FF1B1B1B</color>
    <!-- The session card on a dark shade (v11 notif-android, dark). -->
    <color name="ambient_title">#FFE6E0E9</color>
    <color name="ambient_subtitle">#FFCAC4D0</color>
    <color name="ambient_ice">#FFCBBCFD</color>
    <color name="ambient_ice_held">#80CBBCFD</color>
    <color name="ambient_rail_track">#1FFFFFFF</color>
    <color name="ambient_divider">#14FFFFFF</color>
    <!-- The home-screen widgets by night (v11 wg-home, dark). -->
    <color name="widget_background">#FF1C1C1E</color>
    <color name="widget_ink">#FFFFFFFF</color>
    <color name="widget_label">#FFA1A1A8</color>
    <color name="widget_accent">#FF6B5CF0</color>
    <!-- White on the accent pill by night too: the pill stays the accent. -->
    <color name="widget_on_accent">#FFFFFFFF</color>
    <color name="widget_well">#1AFFFFFF</color>
    <color name="widget_dim">#FF505050</color>
    <color name="widget_day_empty">#FFD8D4CC</color>
    <!-- The frost shield, the same as by day on purpose: §4 draws one
         palette, and the shield is the design's own surface (like the
         widgets), not system chrome that follows the theme. Twins so that a
         dark frost, if one is ever drawn, has somewhere to go. -->
    <color name="freeze_ground_top">#FFF8F6FF</color>
    <color name="freeze_ground_mid">#FFEBE5FC</color>
    <color name="freeze_ground_bottom">#FFDDD4F8</color>
    <color name="freeze_ink">#FF1A1320</color>
    <color name="freeze_line">#FF584F70</color>
    <color name="freeze_primary">#FF111111</color>
    <color name="freeze_on_primary">#FFFFFFFF</color>
    <color name="freeze_secondary">#E0FFFFFF</color>
    <color name="freeze_thaw_glyph">#FF6B5CF0</color>
</resources>
