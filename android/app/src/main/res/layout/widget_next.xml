<?xml version="1.0" encoding="utf-8"?>
<!--
  Next (v11 wg-home): one task, not three. A list makes a student choose
  again, and choosing again is the decision that stalled them in the first
  place. The label, the task large, then the time and class under a dot in the
  class's own colour.

  The XML defaults are the design's own sample ("Networks revision",
  2:00 PM · CN 302): this layout is also the widget gallery's preview, and an
  empty state there would be the least persuasive picture of it at the one
  moment it is chosen. NextWidget overwrites every value on the home screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/WidgetSurface"
    android:clipToOutline="true"
    android:orientation="vertical">

    <TextView
        style="@style/WidgetLabel"
        android:text="Next" />

    <!-- The title takes the room between the label and the time, so on a
         short launcher cell it loses a line rather than pushing the time off
         the bottom. -->
    <TextView
        android:id="@+id/next_title"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:gravity="top"
        android:maxLines="3"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.1"
        android:textStyle="bold"
        android:textSize="17sp"
        android:textColor="@color/widget_ink"
        android:text="Networks revision" />

    <!-- Nothing scheduled is not a failure, and never says so. -->
    <TextView
        android:id="@+id/next_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:gravity="top"
        android:includeFontPadding="false"
        android:textStyle="bold"
        android:textSize="17sp"
        android:textColor="@color/widget_label"
        android:text="Nothing scheduled"
        android:visibility="gone" />

    <!-- "2:00 PM · CN 302", after a dot in the class's own colour. -->
    <LinearLayout
        android:id="@+id/next_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/next_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot" />

        <TextView
            android:id="@+id/next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:textSize="13sp"
            android:textColor="@color/widget_label"
            android:text="2:00 PM · CN 302" />
    </LinearLayout>
</LinearLayout>
