<?xml version="1.0" encoding="utf-8"?>
<!--
  Next (spec §5): one task, not three. A list makes a student choose again,
  and choosing again is the decision that stalled them in the first place.

  The XML defaults are the spec's own sample ("Ch. 4 problem set", 14:00):
  this layout is also the widget gallery's preview, and an empty state there
  would be the least persuasive picture of it at the one moment it is chosen.
  NextWidget overwrites every value on the home screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/WidgetSurface"
    android:clipToOutline="true"
    android:orientation="vertical">

    <TextView
        style="@style/WidgetLabel"
        android:text="NEXT" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/next_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:textSize="14sp"
        android:textColor="#FFFFFFFF"
        android:text="Ch. 4 problem set" />

    <!-- Nothing scheduled is not a failure, and never says so. -->
    <TextView
        android:id="@+id/next_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textSize="14sp"
        android:textColor="@color/widget_meta"
        android:text="Nothing scheduled"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Time only, as §5 draws it: "• 14:00". The subject is already said by
         the dot's colour. -->
    <LinearLayout
        android:id="@+id/next_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/next_dot"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginEnd="5dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot" />

        <TextView
            android:id="@+id/next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFamily="monospace"
            android:textSize="10.5sp"
            android:textColor="@color/widget_meta"
            android:text="14:00" />
    </LinearLayout>
</LinearLayout>
