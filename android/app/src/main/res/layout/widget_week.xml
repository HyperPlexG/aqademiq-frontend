<?xml version="1.0" encoding="utf-8"?>
<!--
  This week (v11 wg-home): seven marks, and no judgement. A day the student
  checked in wears Ada at the mood they logged, as the app's week row draws
  her; a day they did not is an empty dashed outline, never a puddle, because
  absence is not depletion. Today, still open, is the outline in the accent
  with a "+", and today's letter is the only accent. No count, no percentage,
  no red.

  Spread edge to edge, as the row is in the app. Each day is a 34dp cell: the
  mood cube draws at its own 30dp, the outline at 27dp (scaleType center). The
  defaults are the design's sample (Monday Good, Tuesday OK, today Wednesday)
  for the gallery; WeekWidget sets every cell.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/WidgetSurface"
    android:clipToOutline="true"
    android:orientation="vertical">

    <TextView
        style="@style/WidgetLabel"
        android:text="This week" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

