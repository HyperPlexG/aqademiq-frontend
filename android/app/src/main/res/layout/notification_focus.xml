<?xml version="1.0" encoding="utf-8"?>
<!--
  The session card, expanded (v11 notif-android): the session cube, the task,
  "Running · Deep Work", the countdown, the rail, then Freeze and End under a
  hairline. The header row above it (Ada's mark in an ice disc, "Aqademiq ·
  Focus") is the system's, from the small icon, setColor and setSubText.

  Things here are load-bearing:

  * Every colour is a resource with a values-night twin. The shade is light on
    a light-theme phone and dark on a dark one, and the first version of this
    card hard-coded the dark palette: white on near-white for half of users.
  * No horizontal padding. Since Android 12 the system insets a custom view to
    line up with the header text; adding our own pushes the cube into the
    middle. The cube's glyph carries its own margin (3 of its 24 units), which
    is what the negative start margin on its ImageView takes back.
  * The row is sized for the narrowest real case, not the widest. On a 360dp
    Samsung the app icon takes the card's left edge and leaves a 252dp column.
  * The cube is the timer, trimmed to the time left. A notification cannot
    trim a path, so ambient_cube is a level-list of pre-drawn trims and the
    service picks one with setImageLevel. It moves on a push, never per second.
  * The Chronometer is why this is a custom layout at all: with countDown and
    a base of the session's end instant, the system ticks it itself, so nothing
    in the app wakes to move the clock. Frozen swaps it for time_static,
    because a system-ticked countdown cannot be paused, and rail for
    rail_frozen, whose fill is at half.

  Freeze and End are views, not notification actions, because the system draws
  actions in its own colour and case and the design gives them theirs.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/cube"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="-5dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ambient_cube" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/task"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/ambient_title" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textSize="14sp"
                android:textColor="@color/ambient_subtitle" />
        </LinearLayout>

        <Chronometer
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:includeFontPadding="false"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/ambient_title" />

        <TextView
            android:id="@+id/time_static"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:includeFontPadding="false"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/ambient_ice"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/rail"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="14dp"
        android:max="100"
        android:progressDrawable="@drawable/rail_progress" />

    <ProgressBar
        android:id="@+id/rail_frozen"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="14dp"
        android:max="100"
        android:progressDrawable="@drawable/rail_progress_frozen"
        android:visibility="gone" />

    <!-- A plain View is not allowed in a RemoteViews layout; an ImageView is. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:contentDescription="@null"
        android:background="@color/ambient_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/action_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:text="Freeze"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/ambient_ice" />

        <TextView
            android:id="@+id/action_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="?android:attr/selectableItemBackground"
            android:text="End"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/ambient_subtitle" />
    </LinearLayout>
</LinearLayout>
