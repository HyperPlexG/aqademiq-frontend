<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Push Notifications (APNs). Xcode promotes this to `production` for
	     distribution/TestFlight archives; `development` is correct for the file. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Lets task reminders deliver as time-sensitive (interruption-level in the
	     push payload), breaking through Focus / Scheduled Summary batching. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- App freeze needs com.apple.developer.family-controls here too. It is
	     deliberately NOT in this file yet: a distribution profile only carries
	     it once Apple has approved Family Controls for com.r13.aqademiq, and
	     until then a TestFlight / App Store export with the key fails to sign.
	     `ruby ios/add_freeze_targets.rb` adds it, together with the three
	     freeze extensions (APP_FREEZE.md §5). Without it the app builds and
	     ships as before and App freeze reports itself as off. -->
	<!-- The only channel between the app and its widget extension: the session
	     state the lock screen, the Island and the widgets all render from.
	     Must match AmbientWidgets.entitlements and AmbientStore.appGroup.
	     App freeze shares it too (FreezeStore.appGroup, and the Freeze*
	     extensions' entitlements). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.r13.aqademiq.shared</string>
	</array>
</dict>
</plist>
