<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Screen Time. Must be on the app and on all three freeze extensions.
	     Development builds get it with automatic signing; distribution needs
	     Apple's approval per bundle id (APP_FREEZE.md §5). -->
	<key>com.apple.developer.family-controls</key>
	<true/>
	<!-- The only channel between the app and this extension: the policy, the
	     picked selections, the thaw-request queue. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.r13.aqademiq.shared</string>
	</array>
	<!-- No com.apple.developer.usernotifications.time-sensitive here (yet):
	     Xcode's automatic signing cannot add that capability to a new
	     extension id ("not found and could not be included in profile"), so
	     signing fails with it. Without it iOS delivers "Thaw in Aqademiq" as
	     an ordinary notification, which a study Focus may hold back. To get it
	     back: tick Time Sensitive Notifications on com.r13.aqademiq.freeze-action
	     in Certificates, Identifiers & Profiles, then restore this key:
	       <key>com.apple.developer.usernotifications.time-sensitive</key>
	       <true/> -->
</dict>
</plist>
